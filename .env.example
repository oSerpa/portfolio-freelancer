# Chave da API do Resend (https://resend.com/api-keys). Configure na Vercel em Settings > Environment Variables.
RESEND_API_KEY=
# Opcional: e-mail que recebe os orçamentos (padrão: o e-mail em src/data/site.ts)
ORCAMENTO_EMAIL=
# Opcional: remetente, depois de verificar um domínio próprio no Resend
RESEND_FROM=
